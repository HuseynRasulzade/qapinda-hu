---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; items?: { n: string; t: string; d: string }[] }
const { lang, items } = Astro.props;
const list = items ?? t(lang).steps.items;
---
<ol class="steps" data-stagger>
  {list.map((s) => (
    <li class="step" data-tilt>
      <span class="step-n">{s.n}</span>
      <h3>{s.t}</h3>
      <p>{s.d}</p>
    </li>
  ))}
</ol>
